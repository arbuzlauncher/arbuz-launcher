!ifndef LANG_KAZAKH
!define LANG_KAZAKH 1087
!endif
LangString RunApp ${LANG_KAZAKH} "Arbuz Launcher іске қосыңыз"
LangString Desktop ${LANG_KAZAKH} "Жұмыс үстелі таңбашасын жасаңыз"
LangString AskData ${LANG_KAZAKH} "Сондай-ақ параметрлерді, профильдерді, әлемдерді және тіркелгілерді жою керек пе?"
LangString Busy ${LANG_KAZAKH} "Іске қосу құралы жұмыс істеп тұр. Оны жауып, әрекетті қайталаңыз."
!ifndef LANG_KYRGYZ
!define LANG_KYRGYZ 1088
!endif
LangString RunApp ${LANG_KYRGYZ} "Arbuz Launcherди иштетиңиз"
LangString Desktop ${LANG_KYRGYZ} "Иш такта жарлыгын түзүү"
LangString AskData ${LANG_KYRGYZ} "Ошондой эле жөндөөлөрдү, профилдерди, дүйнөлөрдү жана эсептерди жок кыласызбы?"
LangString Busy ${LANG_KYRGYZ} "Ишке киргизгич иштеп жатат. Аны жаап, кайра аракет кылыңыз."
!ifndef LANG_TAJIK
!define LANG_TAJIK 1064
!endif
LangString RunApp ${LANG_TAJIK} "Arbuz Launcher -ро иҷро кунед"
LangString Desktop ${LANG_TAJIK} "Миёнабури мизи корӣ эҷод кунед"
LangString AskData ${LANG_TAJIK} "Ҳамчунин танзимотҳо, профилҳо, ҷаҳониён ва ҳисобҳоро нест кунед?"
LangString Busy ${LANG_TAJIK} "Оғозкунанда кор мекунад. Онро пӯшед ва бори дигар кӯшиш кунед."
!ifndef LANG_INUKTITUT
!define LANG_INUKTITUT 1117
!endif
LangString RunApp ${LANG_INUKTITUT} "ᐊᐅᓚᑦᑎᓗᑎᑦ Arbuz ᖃᖓᑦᑕᖅᑎᑕᐅᓯᒪᔪᒥᒃ"
LangString Desktop ${LANG_INUKTITUT} "ᓴᖅᑭᑦᑎᓗᑎᑦ ᖃᕆᑕᐅᔭᒃᑯᑦ ᓇᐃᓈᕈᑎᒥᒃ"
LangString AskData ${LANG_INUKTITUT} "ᐲᔭᐃᓗᑎᓪᓗ ᐋᖅᑭᒃᓯᒪᓂᖏᓐᓂᒃ, ᓇᓗᓇᐃᔭᖅᓯᒪᔪᓂᒃ, ᓄᓇᕐᔪᐊᓂᒃ ᐊᒻᒪᓗ ᐊᑭᓕᒃᓴᓂᒃ?"
LangString Busy ${LANG_INUKTITUT} "ᖃᖓᑦᑕᖅᑎᑕᐅᓯᒪᔪᖅ ᐃᖏᕐᕋᔪᖅ. ᒪᑐᓗᒍ ᐆᒃᑐᑲᓐᓂᕐᓗᒍᓗ."
!ifndef LANG_OLBANIAN
!define LANG_OLBANIAN 4096
!endif
LangString RunApp ${LANG_OLBANIAN} "Запустить Arbuz Launcher"
LangString Desktop ${LANG_OLBANIAN} "Создать йарлыкъ на рабочемъ столе"
LangString StartMenuShortcut ${LANG_OLBANIAN} "Создать йарлыкъ въ меню «Пускъ»"
LangString ShortcutsTitle ${LANG_OLBANIAN} "Йарлыки"
LangString ShortcutsSubtitle ${LANG_OLBANIAN} "Выберите, какие йарлыки создать."
LangString NeedAdminInstall ${LANG_OLBANIAN} "Для установки для всехъ пользователей нужны права администратора."
LangString MULTIUSER_TEXT_INSTALLMODE_TITLE ${LANG_OLBANIAN} "Режимъ установки"
LangString MULTIUSER_TEXT_INSTALLMODE_SUBTITLE ${LANG_OLBANIAN} "Выберите, какъ установить Arbuz Launcher: для всехъ пользователей или для одного."
LangString MULTIUSER_INNERTEXT_INSTALLMODE_TOP ${LANG_OLBANIAN} "Выберите режимъ установки:"
LangString MULTIUSER_INNERTEXT_INSTALLMODE_ALLUSERS ${LANG_OLBANIAN} "Установить для всехъ пользователей (права администратора)"
LangString MULTIUSER_INNERTEXT_INSTALLMODE_CURRENTUSER ${LANG_OLBANIAN} "Установить для одного пользователя (рекомендуется)"
LangString AskData ${LANG_OLBANIAN} "Удалить также настройки, профили, миры и аккаунты?"
LangString Busy ${LANG_OLBANIAN} "Лаунчеръ запущенъ. Закройте его и повторите."
